{
    "name": "react-ts-graphql",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@apollo/client": "^3.12.5",
        "@reduxjs/toolkit": "^1.8.1",
        "@testing-library/jest-dom": "^5.16.4",
        "@testing-library/react": "^13.0.1",
        "@testing-library/user-event": "^14.1.1",
        "@types/jest": "^27.4.1",
        "@types/node": "^17.0.25",
        "@types/react": "^18.0.6",
        "@types/react-dom": "^18.0.2",
        "graphql": "^16.10.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-redux": "^8.0.1",
        "react-scripts": "5.0.1",
        "redux-logger": "^3.0.6",
        "reselect": "^5.1.1",
        "styled-components": "^6.1.14",
        "typescript": "^4.6.0",
        "web-vitals": "^2.1.0"
    },
    "scripts": {
        "start": "react-scripts start",
        "build": "react-scripts build",
        "test": "react-scripts test",
        "eject": "react-scripts eject",
        "schema:download": "npx apollo service:download --endpoint=https://anilist.co/graphql ./src/app/graphql/graphql-schema.json",
        "schema:generate-watch": "npx apollo codegen:generate --localSchemaFile=./src/app/graphql/graphql-schema.json --target=typescript --tagName=gql --watch"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@types/redux-logger": "^3.0.13",
        "@types/styled-components": "^5.1.34"
    }
}
